require "./type"

module Carbon
  module Hooks
    # Renders managed shell scripts for Git hooks with robust fallback chains
    class HookTemplate
      START_DELIMITER = "# >>> CARBON AUTO-VERSION HOOK >>>"
      END_DELIMITER   = "# <<< CARBON AUTO-VERSION HOOK <<<"

      getter hook_type : HookType
      getter command : String

      def initialize(@hook_type : HookType, command : String? = nil)
        @command = command || @hook_type.default_command
      end

      # Renders the managed hook block
      def render : String
        String.build do |io|
          io.puts START_DELIMITER
          io.puts "# Generated by Carbon. Do not edit this block manually."
          io.puts %(if [ -f "bin/carbon" ]; then)
          io.puts %(  ./bin/carbon #{@command})
          io.puts %(elif [ -f "bin/carbon.exe" ]; then)
          io.puts %(  ./bin/carbon.exe #{@command})
          io.puts %(elif command -v carbon >/dev/null 2>&1; then)
          io.puts %(  carbon #{@command})
          io.puts %(elif command -v crystal >/dev/null 2>&1; then)
          io.puts %(  if [ -f "src/carbon/cli.cr" ]; then)
          io.puts %(    crystal run src/carbon/cli.cr -- #{@command})
          io.puts %(  elif [ -f "lib/carbon/src/carbon/cli.cr" ]; then)
          io.puts %(    crystal run lib/carbon/src/carbon/cli.cr -- #{@command})
          io.puts %(  fi)
          io.puts %(fi)
          io.print END_DELIMITER
        end
      end

      def self.pre_commit(command : String = "bump --hook") : String
        new(HookType::PreCommit, command).render
      end

      def self.post_merge(command : String = "sync") : String
        new(HookType::PostMerge, command).render
      end

      def self.post_checkout(command : String = "sync") : String
        new(HookType::PostCheckout, command).render
      end

      def self.pre_push(command : String = "check") : String
        new(HookType::PrePush, command).render
      end
    end
  end
end
